MONGO_URI=your-mongodb-connection-string
PORT=5000
# Use a long, random secret (32+ chars). Generate with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret
# Access-token lifetime (optional; default 7d). Accepts zeit/ms strings e.g. 15m, 12h, 7d
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend origins (optional; falls back to the deployed frontend)
CLIENT_ORIGINS=http://localhost:5173
# Google OAuth 2.0 Web-application Client ID (from Google Cloud console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
